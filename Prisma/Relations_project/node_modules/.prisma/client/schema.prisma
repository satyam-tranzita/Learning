generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  profile   Profile?
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  phone  String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])
}
